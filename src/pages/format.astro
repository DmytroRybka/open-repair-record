---
import Base from "../layouts/Base.astro";
import { EXAMPLES } from "../examples";
import Walkthrough from "../components/Walkthrough.astro";
import schema from "../schema/orr-0.1.schema.json";

// The field reference is generated from the JSON Schema, so the explanations can never drift from it.
type Node = Record<string, any>;
const defs = (schema as Node).$defs as Record<string, Node>;
const resolve = (n: Node): Node => {
  if (!n.$ref) return n;
  const def = defs[String(n.$ref).split("/").pop()!]!;
  return { ...def, ...n, description: n.description ?? def.description, _def: String(n.$ref).split("/").pop() };
};
interface Row { path: string; kind: string; values?: string[]; text: string; example?: string; required: boolean }
const kindOf = (n: Node): string =>
  n.const !== undefined ? `always "${n.const}"` : n.enum ? "one of" : n._def === "date" ? "date" : n.type === "boolean" ? "yes / no"
    : n.type === "array" ? "list" : n.type === "object" || n.properties ? "group" : "text";
const walk = (prefix: string, node: Node, required: string[], out: Row[]) => {
  for (const [key, raw] of Object.entries((node.properties ?? {}) as Record<string, Node>)) {
    const n = resolve(raw);
    const path = prefix ? `${prefix}.${key}` : key;
    const ex = (n.examples ?? [])[0];
    out.push({
      path: n.type === "array" ? `${path}[]` : path,
      kind: kindOf(n),
      values: n.enum,
      text: n.description ?? "",
      example: ex === undefined || typeof ex === "object" ? undefined : String(ex),
      required: required.includes(key),
    });
    if (n.type === "array" && n.items) walk(`${path}[]`, resolve(n.items), [], out);
    else if (n.properties) walk(path, n, n.required ?? [], out);
  }
};
const GROUPS: [string, string[]][] = [
  ["Fundamentals", ["orr_version", "id", "title", "timezone", "related_ids"]],
  ["What was reported", ["context"]],
  ["What the contractor says", ["work"]],
  ["Checks", ["checks"]],
  ["Evidence", ["evidence"]],
  ["The resident", ["resident"]],
  ["Still open", ["open_items"]],
  ["Closure", ["status", "closure"]],
  ["Later additions", ["history"]],
];
const allRows: Row[] = [];
walk("", schema as Node, (schema as Node).required, allRows);
const top = (r: Row) => r.path.split(/[.[]/)[0]!;
const reference = GROUPS.map(([title, keys]) => ({ title, rows: allRows.filter((r) => keys.includes(top(r))) }));

const mapping = [
  ["id", "work_order_id", ""],
  ["context.reported_at", "date_reported", ""],
  ["context.location", "address_id, location_of_repair", "theirs is an address identifier plus where in the home"],
  ["context.symptom", "description_of_work", "theirs describes the problem from a schedule of rates or a local code"],
  ["work[].at", "actual_start_date_time, actual_completion_date_time", "ORR keeps one time per statement"],
  ["work[].by", "contractor_organisation, work_order_complete.operatives_used", ""],
  ["work[].done", "work_order_complete.completed_work_elements", ""],
  ["work[].follow_up, open_items[]", "work_order_complete.follow_on_work", "theirs is a single text field"],
  ["status, closure, history[]", "work_order_status_history (status_code, reason, reason_code, created_date_time), job_status_update", "codes are free text in both"],
  ["checks[], evidence[], resident", "no equivalent in the work_order definitions", ""],
  ["not in ORR", "work_priority, planned dates, estimated_cost, repair_sla_breach_flag, access information, alerts, trade and schedule-of-rates codes", "left to the operator's own system"],
];
---
<Base title="Format 0.1" description="The Open Repair Record 0.1 JSON format and JSON Schema: fields, rules, examples, and an informal mapping to existing housing repair data models." section="format">
  <div class="wrap page-head">
    <div class="prose" style="max-width:860px">
      <p class="eyebrow">Format 0.1</p>
      <h1>The record as data</h1>
      <p class="lead">
        The builder saves every record as a small JSON file. The format is open (MIT), versioned, and described by a
        JSON Schema, so any tool can read and write it.
      </p>
      <div class="btn-row" style="margin:20px 0 8px">
        <a class="btn btn-primary" href="/schema/orr-0.1.schema.json">JSON Schema 0.1</a>
        <a class="btn" href="/examples/ac-no-reply.json">An example file</a>
      </div>
      <p class="small muted">JSON Schema draft 2020-12. Schema id: <code>https://openrepairrecord.com/schema/orr-0.1.schema.json</code></p>

    </div>

    <h2 id="step-by-step">Build a record, step by step</h2>
    <p class="muted" style="max-width:46rem">
      One fictional repair, written as a file one part at a time. Scroll, and the part being explained lights up. The
      same nine parts are the sections of the <a href="/build/">builder</a> and of the printed report.
    </p>
    <Walkthrough />

    <div class="prose" style="max-width:860px">
      <h2 id="reference">Field reference</h2>
      <p>
        Every field, with what it means. Generated from the <a href="/schema/orr-0.1.schema.json">JSON Schema</a>, so
        this table and the schema always say the same thing. Only the fields marked <strong>required</strong> must be
        present; everything else is written when you know it.
      </p>
      {reference.map((g) => (
        <>
          <h3>{g.title}</h3>
          <div class="table-wrap">
            <table class="ref">
              <thead><tr><th>Field</th><th>Type</th><th>What it means</th></tr></thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td><code>{r.path}</code>{r.required && <span class="req">required</span>}</td>
                    <td class="muted">{r.kind}{r.values && <div class="vals">{r.values.map((v) => <code>{v}</code>)}</div>}</td>
                    <td>{r.text}{r.example && <div class="ex">e.g. <code>{r.example}</code></div>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      <p>
        Dates are ISO 8601 as written: <code>2026-10-12</code> or <code>2026-10-12T14:20</code>, in the property's local
        time unless an offset is given. Text is free text: the format does not impose code lists beyond the few
        choices above, which every report needs so that it is read the same way.
      </p>

      <h2>Rules</h2>
      <p>The schema checks the shape. A few rules are about meaning, and the builder's check applies them:</p>
      <ul>
        <li><code>resident.status</code> <code>no_reply</code> stays <code>no_reply</code>. No tool should turn silence into <code>resolved</code>.</li>
        <li>An open record has no <code>closure</code>. Reopening moves the old closure into <code>history[].previous_closure</code>, unchanged.</li>
        <li><code>closure.reason_code</code> <code>confirmed_by_resident</code> needs <code>resident.status</code> <code>resolved</code>.</li>
        <li>A latest <code>work</code> outcome of <code>temporary_fix</code> or <code>partial</code> needs at least one <code>open_items</code> entry.</li>
        <li><code>not_applicable</code> is for common areas. Evidence is never required.</li>
        <li>Entries are added, not rewritten. Corrections go in <code>history</code>.</li>
      </ul>

      <h2>Example files</h2>
      <ul>
        {EXAMPLES.map((e) => <li><a href={`/examples/${e.slug}.json`}>{e.slug}.json</a> · {e.name}</li>)}
      </ul>

      <h2 id="mapping">How it relates to existing models</h2>
      <p>
        Open Repair Record is a practical guide and a small format for one report. It is not a new data standard for
        housing, and it does not replace the models that already exist:
      </p>
      <ul>
        <li><strong>HACT UK Housing Data Standards</strong> cover reactive repairs among much else. We have not mapped ORR to them; if you use them, keep using them.</li>
        <li><strong>MIMOSA CCOM</strong>, <strong>COBie</strong> and <strong>OSCRE</strong> model assets, completed work and property data in far more depth.</li>
      </ul>
      <p>
        The closest public schema we have read is the
        <a href="https://github.com/data-futurists/damp-and-mould-standards-concept">damp-and-mould data standards proof of concept</a>
        (data-futurists, MIT, 2025). Its own README says it is a proof of concept, not finalised, and not for live
        services. The table below is our informal reading of its <code>work_order</code> definitions, not an official
        mapping:
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Open Repair Record</th><th>Damp-and-mould proof of concept</th><th>Note</th></tr></thead>
          <tbody>
            {mapping.map(([a, b, n]) => <tr><td><code>{a}</code></td><td>{b}</td><td class="muted">{n}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>
        The gap is the point: work-order models describe the job; ORR adds who checked what, what the resident
        answered, and why the record was closed. If an existing model covers what you need, use it, and treat ORR as a
        guide for filling it in well.
      </p>

      <h2 id="changelog">Versions</h2>
      <ul>
        <li><strong>0.1</strong> (October 2026): first public draft. Breaking changes are possible before 1.0; every change will be listed here with a new version number.</li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .ref { table-layout: fixed; }
  .ref th:nth-child(1) { width: 34%; }
  .ref th:nth-child(2) { width: 18%; }
  .ref td:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ref code { overflow-wrap: anywhere; }
  .req { display: block; margin-top: 3px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-ink); }
  .vals { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .vals code { font-size: 0.76rem; }
  .ex { margin-top: 4px; font-size: 0.84rem; color: var(--muted); }
  @media (max-width: 640px) { .ref td:first-child { white-space: normal; word-break: break-word; } .ref th:nth-child(1) { width: 36%; } .ref th:nth-child(2) { width: 22%; } }
</style>
