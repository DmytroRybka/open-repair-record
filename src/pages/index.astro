---
import Base from "../layouts/Base.astro";
import { EXAMPLES } from "../examples";
import LoopDiagram from "../components/LoopDiagram.astro";

const parts = [
  ["What was reported", "Where, when, and the symptom in the reporter's words. Kept apart from the diagnosis."],
  ["What the contractor says", "Who reported the work, what they did, the outcome they claim, and anything left unfinished."],
  ["Checks and evidence", "Who checked, how, what they found, and what the check did not cover. Photos or test logs, if any."],
  ["The resident's answer", "Resolved, not resolved, not asked, waiting, no reply, or not applicable. Never assumed."],
  ["Who closed it, and why", "The person who closed the record, the reason, and what still needs following up."],
  ["Later additions", "A late reply, a revisit or a correction is added. Nothing earlier is rewritten."],
];

const principles = [
  ["Keep each source separate", "A contractor's statement, a coordinator's check and a resident's answer are different things. The record says who said what."],
  ["No reply means no reply", "Silence is never turned into a confirmation, however long it lasts."],
  ["A temporary fix is not a fix", "If something is left to do, it gets an owner and a date, and the record stays honest about it."],
  ["Say what a check did not cover", "\"Ran it for 15 minutes\" and \"did not inspect the unit\" are both useful."],
  ["Add, don't rewrite", "Corrections and reopenings are new entries. The earlier version stays readable."],
  ["A record is not a certificate", "It documents claims and checks. It does not certify safety or quality, and a photo is never required."],
];
---
<Base
  title="Open Repair Record: an honest repair completion report"
  description="The job card says Completed. A free, open tool for an honest repair completion report: what was done, what was checked, and is it solved?"
  schema={{
    "@type": "WebSite",
    name: "Open Repair Record",
    url: "https://openrepairrecord.com/",
    description:
      "An open guide, a free report builder and a small JSON format for writing down what a completed repair actually means: what was done, what was checked, what the resident answered, and who closed it and why.",
    inLanguage: "en",
    license: "https://creativecommons.org/licenses/by/4.0/",
  }}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Work order close-out</p>
        <h1>The job card says <span class="nowrap">"Completed".</span> Does anyone know what that means?</h1>
        <p class="lead">
          What was done, what was checked, and is the resident's problem actually solved? Open Repair Record is an open
          guide and a free tool for an honest close-out: one record anyone can read, in any system.
        </p>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn-primary" href="/build/">Create a close-out report</a>
          <a class="btn" href="/guide/">Read the guide</a>
        </div>
        <p class="small muted" style="margin-top:14px">Free, no account, and what you type never leaves your browser. Print it, save it as PDF, or send it on WhatsApp. Prefer paper? <a href="/template/">Print the blank template</a>.</p>
      </div>

      <figure class="versus" aria-label="The same job twice: a job card marked Completed, and the same job as an Open Repair Record">
        <div class="jobcard" aria-label="A typical job card">
          <div class="jc-head"><span>JOB CARD</span><span>No. Q-1204</span></div>
          <dl>
            <div><dt>Location</dt><dd>Tower 2, Apt 1204</dd></div>
            <div><dt>Fault</dt><dd>AC leaking</dd></div>
            <div><dt>Technician</dt><dd>Ravi K.</dd></div>
            <div><dt>Remarks</dt><dd>Done.</dd></div>
          </dl>
          <div class="stamp" aria-label="Stamped completed">Completed</div>
        </div>
        <div class="arrow" aria-hidden="true">→</div>
        <div class="orr" aria-label="The same job as an Open Repair Record">
          <div class="orr-head"><span>Open Repair Record</span><span>Q-1204</span></div>
          <div class="orr-row"><b>Contractor says</b>Resolved: cleared the drain · Ravi K., 11 Oct</div>
          <div class="orr-row"><b>Checked</b>15-min test run · unit not inspected</div>
          <div class="orr-row orr-amber"><b>Resident</b>No reply (asked 11 Oct)</div>
          <div class="orr-row"><b>Closed</b>Work reported done, no reply after 4 days</div>
        </div>
        <figcaption class="small muted">The same fictional job, twice. <a href="/guide/good-and-weak/">Why it matters →</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        <div>
          <h2 class="card-h" style="margin-top:0">Repeat call-outs</h2>
          <p class="muted" style="margin:0">A job closed on the contractor's word looks like a first-time fix, until the resident calls again.</p>
        </div>
        <div>
          <h2 class="card-h" style="margin-top:0">Disputes</h2>
          <p class="muted" style="margin:0">When an owner or a resident disputes a repair, a record of who said what is the first thing you need.</p>
        </div>
        <div>
          <h2 class="card-h" style="margin-top:0">Handover</h2>
          <p class="muted" style="margin:0">A new contractor, a new manager, a new system: the record travels as a PDF or a JSON file.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top:0">How the loop closes</h2>
      <p class="muted" style="max-width:46rem">
        Each person adds their own part to one record. The job closes on the resident's answer, not on the contractor's
        word, and a "not fixed" sends it back round.
      </p>
      <LoopDiagram />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top:0">One record, six parts</h2>
      <p class="muted" style="max-width:44rem">
        A good completion report keeps each source of information apart. There is no single "done" box to tick.
      </p>
      <div class="grid grid-3" style="margin-top:20px">
        {parts.map(([title, text], i) => (
          <div class="card">
            <div class="part-num">{i + 1}</div>
            <h3>{title}</h3>
            <p class="muted" style="margin:0">{text}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:18px"><a href="/guide/parts/">The six parts in detail →</a> · <a href="/format/#step-by-step">See a record built step by step →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Five worked examples</h2>
      <p class="muted" style="max-width:44rem">Fictional repairs that show the hard cases: a temporary fix, a resident who never answers, a fault that comes back, and a visit with no access.</p>
      <div class="grid grid-3" style="margin-top:20px">
        {EXAMPLES.map((e) => (
          <a class="card card-link" href={`/examples/${e.slug}/`}>
            <h3>{e.name}</h3>
            <p class="muted">{e.lesson}</p>
            <span class="more">See the report →</span>
          </a>
        ))}
        <a class="card card-link" href="/build/" style="background:var(--accent-soft);border-color:#bcdcd2">
          <h3>Your own repair</h3>
          <p class="muted">Fill in a short form. The check tells you what is missing or contradicts itself before you send it.</p>
          <span class="more">Create a report →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Principles</h2>
      <div class="grid grid-2" style="margin-top:20px">
        {principles.map(([title, text]) => (
          <div>
            <h3 style="margin-top:0">{title}</h3>
            <p class="muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card" style="display:grid;gap:12px">
        <h2 style="margin:0">Open, and yours to use</h2>
        <p style="margin:0">
          The guide, the template and the examples are <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          The builder and the <a href="/format/">JSON format</a> are MIT. Use them with any contractor and any software,
          copy them into your own instructions, or build them into your own tool.
        </p>
        <p class="muted small" style="margin:0">
          Open Repair Record is a practical guide and toolkit, not an official standard. Where it overlaps existing
          housing data models, the <a href="/format/#mapping">format page</a> says so.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; } }
  .hero h1 { font-size: clamp(2rem, 4.6vw, 3rem); }
  .nowrap { white-space: nowrap; }
  .versus { margin: 0; display: grid; gap: 14px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .versus { grid-template-columns: minmax(0, 0.9fr) auto minmax(0, 1.1fr); } }
  .versus figcaption { grid-column: 1 / -1; }
  .arrow { font-size: 28px; color: var(--muted); text-align: center; }
  @media (max-width: 559px) { .arrow { transform: rotate(90deg); } }
  .jobcard { position: relative; background: #fbfaf5; border: 1px solid #d8d3c4; border-radius: 6px; padding: 14px 16px 62px; font-family: var(--mono); font-size: 0.8rem; color: #3b3a33; box-shadow: 2px 3px 0 rgb(0 0 0 / 5%); }
  .jc-head { display: flex; justify-content: space-between; border-bottom: 2px solid #3b3a33; padding-bottom: 6px; margin-bottom: 8px; font-weight: 700; letter-spacing: 0.06em; }
  .jobcard dl { margin: 0; }
  .jobcard dl div { display: grid; grid-template-columns: 6.5em 1fr; border-bottom: 1px dashed #d8d3c4; padding: 5px 0; }
  .jobcard dt { color: #8a8574; }
  .jobcard dd { margin: 0; }
  .stamp { position: absolute; right: 14px; bottom: 14px; transform: rotate(-12deg); border: 3px solid #b42318; color: #b42318; font: 800 1.05rem/1 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 10px; border-radius: 6px; opacity: 0.85; background: rgb(255 255 255 / 55%); }
  .orr { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; box-shadow: var(--shadow); display: grid; gap: 8px; }
  .orr-head { display: flex; justify-content: space-between; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); padding-bottom: 4px; border-bottom: 2px solid var(--ink); }
  .orr-row { border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font-size: 0.86rem; line-height: 1.35; }
  .orr-row b { display: block; font-size: 0.66rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin-bottom: 1px; }
  .orr-amber { background: var(--amber-soft); border-color: #f0d9a8; }
</style>
