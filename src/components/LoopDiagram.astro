---
/**
 * How the loop closes: who adds what to the record, and what happens when the resident says no.
 * Wide screens get the diagram; narrow screens get the same story as five steps.
 */
---
<figure class="loop" aria-labelledby="loop-cap">
  <svg class="loop-svg" viewBox="0 0 1000 600" role="img" aria-labelledby="loop-title loop-desc">
    <title id="loop-title">How a repair record closes the loop</title>
    <desc id="loop-desc">The contractor states what was done, the coordinator checks and closes, and the resident answers whether it is fixed; all three write to the repair record, which describes the repair. If the resident says it is not fixed, the record reopens and the contractor comes back.</desc>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="#3c4743" />
      </marker>
      <marker id="arrow-loop" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="#c2700a" />
      </marker>
      <filter id="lift" x="-10%" y="-10%" width="120%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#10181420" />
      </filter>
    </defs>

    <!-- The feedback loop, drawn first so it sits behind the nodes. -->
    <path class="loop-path" d="M950 266 V548 Q950 566 932 566 H68 Q50 566 50 548 V266" marker-end="url(#arrow-loop)" />
    <g class="loop-label">
      <rect x="276" y="550" width="448" height="34" rx="17" />
      <text x="500" y="572" text-anchor="middle">Not fixed? The record reopens and the contractor comes back.</text>
    </g>

    <!-- Information about the repair: dashed, into the record. -->
    <path class="info" d="M220 222 H368" marker-end="url(#arrow)" />
    <path class="info" d="M780 222 H632" marker-end="url(#arrow)" />
    <path class="info" d="M500 108 V160" marker-end="url(#arrow)" />
    <path class="info" d="M500 286 V384" marker-end="url(#arrow)" />

    <!-- Work in the real world: solid, onto the repair. -->
    <path class="work" d="M120 266 V440 H368" marker-end="url(#arrow)" />
    <path class="work" d="M880 266 V440 H632" marker-end="url(#arrow)" />

    <!-- Arrow labels -->
    <g class="lbl">
      <rect x="229" y="182" width="132" height="26" rx="13" /><text x="295" y="200" text-anchor="middle">states what was done</text>
      <rect x="645" y="182" width="120" height="26" rx="13" /><text x="705" y="200" text-anchor="middle">answers: fixed?</text>
      <rect x="512" y="121" width="128" height="26" rx="13" /><text x="576" y="139" text-anchor="middle">checks and closes</text>
      <rect x="512" y="322" width="84" height="26" rx="13" /><text x="554" y="340" text-anchor="middle">describes</text>
      <rect x="188" y="406" width="112" height="26" rx="13" /><text x="244" y="424" text-anchor="middle">does the work</text>
      <rect x="690" y="406" width="134" height="26" rx="13" /><text x="757" y="424" text-anchor="middle">reports, lives with it</text>
    </g>

    <!-- Nodes -->
    <g class="node" filter="url(#lift)">
      <rect x="390" y="28" width="220" height="80" rx="14" />
      <circle cx="430" cy="68" r="20" class="ico-bg" />
      <path class="ico" d="M423 58 h14 a3 3 0 0 1 3 3 v16 a3 3 0 0 1 -3 3 h-14 a3 3 0 0 1 -3 -3 v-16 a3 3 0 0 1 3 -3 z M426 56 h8 v5 h-8 z M425 70 l3.5 3.5 l7 -7" />
      <text x="462" y="63" class="t">Coordinator</text>
      <text x="462" y="84" class="s">checks, closes, reopens</text>
    </g>

    <g class="node" filter="url(#lift)">
      <rect x="20" y="178" width="200" height="88" rx="14" />
      <circle cx="60" cy="222" r="20" class="ico-bg" />
      <path class="ico" d="M67.5 212.5 a6 6 0 0 0 -8 8 l-9 9 a2.2 2.2 0 0 0 3 3 l9 -9 a6 6 0 0 0 8 -8 l-3.5 3.5 l-3 -0.5 l-0.5 -3 z" />
      <text x="92" y="216" class="t">Contractor</text>
      <text x="92" y="238" class="s">does the work</text>
    </g>

    <g class="node node-record" filter="url(#lift)">
      <rect x="370" y="160" width="260" height="126" rx="16" />
      <rect x="392" y="182" width="40" height="40" rx="10" fill="#0e6b58" />
      <path d="M401 195 h22 M401 203 h12" stroke="#bfe3d7" stroke-width="3.2" stroke-linecap="round" />
      <path d="M410 211 l4 4 l7.5 -8.5" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="444" y="199" class="t">Repair record</text>
      <text x="444" y="218" class="s">Open Repair Record</text>
      <text x="392" y="250" class="xs">who said what · what was checked</text>
      <text x="392" y="268" class="xs">the resident's answer · why closed</text>
    </g>

    <g class="node" filter="url(#lift)">
      <rect x="780" y="178" width="200" height="88" rx="14" />
      <circle cx="820" cy="222" r="20" class="ico-bg" />
      <path class="ico" d="M820 213 a5 5 0 1 1 0.01 0 z M810 233 a10 8 0 0 1 20 0" />
      <text x="852" y="216" class="t">Resident</text>
      <text x="852" y="238" class="s">says if it's fixed</text>
    </g>

    <g class="node node-repair" filter="url(#lift)">
      <rect x="370" y="384" width="260" height="112" rx="14" />
      <circle cx="412" cy="426" r="20" class="ico-bg" />
      <path class="ico" d="M401 427 l11 -10 l11 10 M404 425 v11 h16 v-11 M412 429 q-3 4 0 6 q3 -2 0 -6 z" />
      <text x="444" y="421" class="t">The repair</text>
      <text x="444" y="442" class="s">the home, the AC, the leak</text>
      <text x="392" y="478" class="xs">what actually happened on site</text>
    </g>
  </svg>

  <ol class="loop-steps" aria-hidden="false">
    <li><b>The resident</b> reports the problem, in their own words.</li>
    <li><b>The contractor</b> does the work and states what was done.</li>
    <li><b>Someone checks</b>, and says what the check did not cover.</li>
    <li><b>The resident answers</b>: fixed, not fixed, or no reply.</li>
    <li><b>The coordinator</b> closes the record, and says why.</li>
    <li class="loop-back"><b>Not fixed?</b> The record reopens, the contractor comes back, and nothing earlier is rewritten.</li>
  </ol>

  <figcaption id="loop-cap">
    <span class="key"><i class="k-info"></i>what goes on the record</span>
    <span class="key"><i class="k-work"></i>work on site</span>
    <span class="key"><i class="k-loop"></i>the feedback loop</span>
  </figcaption>
</figure>

<style>
  .loop { margin: 8px 0 0; }
  .loop-svg { display: none; width: 100%; height: auto; }

  .loop-svg .node rect:first-child { fill: #fff; stroke: #c9d1cc; stroke-width: 1.5; }
  .loop-svg .node-record rect:first-child { fill: #e5f1ed; stroke: #0e6b58; stroke-width: 2; }
  .loop-svg .node-repair rect:first-child { fill: #fbfaf5; stroke: #d8d3c4; stroke-dasharray: none; }
  .loop-svg .ico-bg { fill: #e5f1ed; }
  .loop-svg .ico { fill: none; stroke: #0a5546; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .loop-svg .t { font: 700 18px var(--sans); fill: #17201d; }
  .loop-svg .s { font: 500 13.5px var(--sans); fill: #64706b; }
  .loop-svg .xs { font: 500 12.5px var(--sans); fill: #3c4743; }
  .loop-svg .info { fill: none; stroke: #3c4743; stroke-width: 1.8; stroke-dasharray: 6 6; }
  .loop-svg .work { fill: none; stroke: #3c4743; stroke-width: 1.8; }
  .loop-svg .loop-path { fill: none; stroke: #c2700a; stroke-width: 2.2; }
  .loop-svg .lbl rect { fill: #f6f7f4; stroke: #dfe4e0; }
  .loop-svg .lbl text { font: 600 12.5px var(--sans); fill: #3c4743; }
  .loop-svg .loop-label rect { fill: #fdf3dc; stroke: #f0d9a8; }
  .loop-svg .loop-label text { font: 650 13.5px var(--sans); fill: #8a4b06; }

  .loop-steps { list-style: none; counter-reset: step; margin: 0; padding: 0 0 0 4px; display: grid; gap: 10px; position: relative; }
  .loop-steps li { counter-increment: step; position: relative; padding: 12px 14px 12px 50px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; font-size: 0.95rem; }
  .loop-steps li::before { content: counter(step); position: absolute; left: 12px; top: 11px; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; font-size: 0.85rem; display: grid; place-items: center; }
  .loop-steps .loop-back { background: var(--amber-soft); border-color: #f0d9a8; }
  .loop-steps .loop-back::before { content: "↺"; background: #fff; color: #c2700a; font-size: 1rem; }

  figcaption { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 12px; font-size: 0.84rem; color: var(--muted); }
  .key { display: inline-flex; align-items: center; gap: 8px; }
  .key i { display: inline-block; width: 28px; height: 0; border-top: 2px solid #3c4743; }
  .key .k-info { border-top-style: dashed; }
  .key .k-loop { border-top-color: #c2700a; }
  @media (max-width: 759px) { figcaption { display: none; } }
  /* Wide screens: the diagram; narrow screens: the steps. Kept last so it wins over the rules above. */
  @media (min-width: 760px) { .loop-svg { display: block; } .loop-steps { display: none; } }
</style>
